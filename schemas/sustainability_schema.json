{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "./sustainability_schema.json",
    "title": "Sustainability",
    "description": "Sourced sustainability data. Copy, never compute: every number must appear verbatim in source_quote. On a variant, each field set here replaces the filament's field of the same name (carbon_footprints and relative_claims replace the whole array).",
    "type": "object",
    "properties": {
        "recycled_content": {
            "type": "object",
            "title": "Recycled Content",
            "description": "Share of recycled material in the filament, as declared by the brand",
            "properties": {
                "pct": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 100,
                    "title": "Recycled %",
                    "description": "Recycled content in percent (0-100). null when the source gives no number."
                },
                "pct_qualifier": {
                    "type": "string",
                    "title": "Percentage Qualifier",
                    "description": "How the source qualifies the percentage: exact, up to, or at least",
                    "enum": [
                        "exact",
                        "up_to",
                        "at_least"
                    ],
                    "default": "exact"
                },
                "type": {
                    "type": "string",
                    "title": "Recycled Material Type",
                    "description": "Origin of the recycled material, as stated by the source",
                    "enum": [
                        "post_industrial",
                        "post_consumer",
                        "mixed",
                        "unknown"
                    ]
                },
                "evidence": {
                    "type": "string",
                    "title": "Evidence",
                    "description": "What backs the figure: an ISO 14021 self-declaration, a third-party certificate (GRS, RCS, SCS...), a supplier declaration, or marketing text",
                    "enum": [
                        "iso_14021",
                        "third_party_certified",
                        "supplier_declaration",
                        "marketing"
                    ]
                },
                "source_type": {
                    "type": "string",
                    "title": "Source Type",
                    "description": "primary = the brand's own site, PDF, blog or declaration. secondary = a retailer or press copy of brand text, only when the original can't be reached.",
                    "enum": [
                        "primary",
                        "secondary"
                    ]
                },
                "source_url": {
                    "type": "string",
                    "title": "Source URL",
                    "description": "Where the figure is published",
                    "format": "uri",
                    "pattern": "^https?://",
                    "maxLength": 1000,
                    "x-placeholder": "https://example.com/..."
                },
                "source_quote": {
                    "type": "string",
                    "title": "Source Quote",
                    "description": "Verbatim text from the source. Must contain the number exactly as written.",
                    "minLength": 1,
                    "maxLength": 2000
                },
                "retrieved": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "title": "Retrieved",
                    "description": "Date the source was read (YYYY-MM-DD)"
                },
                "notes": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 1000,
                    "title": "Notes",
                    "description": "Caveats, conflicting sources, or anything a reader needs to interpret the value"
                }
            },
            "additionalProperties": false,
            "required": [
                "pct",
                "type",
                "evidence",
                "source_type",
                "source_url",
                "source_quote",
                "retrieved"
            ]
        },
        "bio_based_content": {
            "type": "object",
            "title": "Bio-based Content",
            "description": "Share of bio-based carbon or material in the filament. Bio-based pigments or additives are not bio-based content.",
            "properties": {
                "pct": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 100,
                    "title": "Bio-based %",
                    "description": "Bio-based content in percent (0-100). null when the source gives no number."
                },
                "pct_qualifier": {
                    "type": "string",
                    "title": "Percentage Qualifier",
                    "description": "How the source qualifies the percentage: exact, up to, or at least",
                    "enum": [
                        "exact",
                        "up_to",
                        "at_least"
                    ],
                    "default": "exact"
                },
                "method": {
                    "type": "string",
                    "title": "Method",
                    "description": "How the bio-based share was determined",
                    "enum": [
                        "astm_d6866",
                        "en_16785",
                        "declared"
                    ]
                },
                "source_type": {
                    "type": "string",
                    "title": "Source Type",
                    "description": "primary = the brand's own site, PDF, blog or declaration. secondary = a retailer or press copy of brand text, only when the original can't be reached.",
                    "enum": [
                        "primary",
                        "secondary"
                    ]
                },
                "source_url": {
                    "type": "string",
                    "title": "Source URL",
                    "description": "Where the figure is published",
                    "format": "uri",
                    "pattern": "^https?://",
                    "maxLength": 1000,
                    "x-placeholder": "https://example.com/..."
                },
                "source_quote": {
                    "type": "string",
                    "title": "Source Quote",
                    "description": "Verbatim text from the source. Must contain the number exactly as written.",
                    "minLength": 1,
                    "maxLength": 2000
                },
                "retrieved": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "title": "Retrieved",
                    "description": "Date the source was read (YYYY-MM-DD)"
                },
                "notes": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 1000,
                    "title": "Notes",
                    "description": "Caveats, conflicting sources, or anything a reader needs to interpret the value"
                }
            },
            "additionalProperties": false,
            "required": [
                "pct",
                "method",
                "source_type",
                "source_url",
                "source_quote",
                "retrieved"
            ]
        },
        "carbon_footprints": {
            "type": "array",
            "title": "Carbon Footprints",
            "description": "On a variant, this array replaces the filament's. An empty array means the filament's figure doesn't apply to this variant.",
            "items": {
                "type": "object",
                "title": "Carbon Footprint",
                "description": "A published carbon footprint figure, copied verbatim from the source",
                "properties": {
                    "value_kg_co2e": {
                        "type": "number",
                        "minimum": 0,
                        "title": "kg CO2e",
                        "description": "Footprint in kg CO2e, exactly as published"
                    },
                    "declared_unit": {
                        "type": "string",
                        "title": "Declared Unit",
                        "description": "What the value refers to. unknown when the source does not say.",
                        "enum": [
                            "per_kg_filament",
                            "per_spool_as_sold",
                            "unknown"
                        ]
                    },
                    "boundary": {
                        "type": "string",
                        "title": "System Boundary",
                        "description": "Life-cycle stages covered: resin production only, filament up to the factory gate, delivery to the customer, or the full life cycle",
                        "enum": [
                            "resin_cradle_to_gate",
                            "filament_cradle_to_gate",
                            "cradle_to_customer",
                            "cradle_to_grave",
                            "unknown"
                        ]
                    },
                    "packaging_included": {
                        "type": "string",
                        "title": "Packaging Included",
                        "description": "Whether spool and packaging are inside the figure",
                        "enum": [
                            "yes",
                            "no",
                            "unknown"
                        ]
                    },
                    "biogenic_carbon": {
                        "type": "string",
                        "title": "Biogenic Carbon",
                        "description": "How biogenic carbon uptake is treated",
                        "enum": [
                            "included",
                            "excluded",
                            "reported_separately",
                            "unknown"
                        ]
                    },
                    "recycled_allocation": {
                        "type": "string",
                        "title": "Recycled Allocation",
                        "description": "How the burden of recycled input is allocated. not_applicable for virgin material.",
                        "enum": [
                            "cut_off",
                            "burden_free_scrap",
                            "other",
                            "unknown",
                            "not_applicable"
                        ]
                    },
                    "method": {
                        "type": "string",
                        "title": "Method",
                        "description": "epd = registered EPD, iso_14067 = product carbon footprint to ISO 14067, lca = other life-cycle assessment, declaration = a figure with no published study",
                        "enum": [
                            "epd",
                            "iso_14067",
                            "lca",
                            "declaration"
                        ]
                    },
                    "standard": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "Standard",
                        "description": "Standard named by the source, e.g. ISO 14067. Only if the source names one."
                    },
                    "tool": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "Tool",
                        "description": "LCA software as named by the source, e.g. SimaPro 9.3.0.2"
                    },
                    "practitioner": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "Practitioner",
                        "description": "Person or firm that performed the study"
                    },
                    "verification": {
                        "type": "string",
                        "title": "Verification",
                        "description": "Independent review of the study",
                        "enum": [
                            "none",
                            "peer_review",
                            "third_party",
                            "epd_registered"
                        ]
                    },
                    "verifier": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "Verifier"
                    },
                    "epd_registration_number": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "EPD Registration Number"
                    },
                    "publicly_available": {
                        "type": "boolean",
                        "title": "Study Publicly Available",
                        "description": "false when the underlying study is only available on request"
                    },
                    "reference_year": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1990,
                        "title": "Reference Year",
                        "description": "Year the data refers to"
                    },
                    "published": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "title": "Published",
                        "description": "Publication date of the source (YYYY-MM-DD)"
                    },
                    "source_type": {
                        "type": "string",
                        "title": "Source Type",
                        "description": "primary = the brand's own site, PDF, blog or declaration. secondary = a retailer or press copy of brand text, only when the original can't be reached.",
                        "enum": [
                            "primary",
                            "secondary"
                        ]
                    },
                    "source_url": {
                        "type": "string",
                        "title": "Source URL",
                        "description": "Where the figure is published",
                        "format": "uri",
                        "pattern": "^https?://",
                        "maxLength": 1000,
                        "x-placeholder": "https://example.com/..."
                    },
                    "source_quote": {
                        "type": "string",
                        "title": "Source Quote",
                        "description": "Verbatim text from the source. Must contain the number exactly as written.",
                        "minLength": 1,
                        "maxLength": 2000
                    },
                    "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "title": "Retrieved",
                        "description": "Date the source was read (YYYY-MM-DD)"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "Notes",
                        "description": "Caveats, conflicting sources, or anything a reader needs to interpret the value"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "value_kg_co2e",
                    "declared_unit",
                    "boundary",
                    "packaging_included",
                    "biogenic_carbon",
                    "recycled_allocation",
                    "method",
                    "verification",
                    "publicly_available",
                    "source_type",
                    "source_url",
                    "source_quote",
                    "retrieved"
                ]
            }
        },
        "relative_claims": {
            "type": "array",
            "title": "Relative Claims",
            "items": {
                "type": "object",
                "title": "Relative Claim",
                "description": "A published reduction relative to a baseline, for brands that publish no absolute figure",
                "properties": {
                    "reduction_pct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "title": "Reduction %",
                        "description": "Reduction in percent, exactly as published"
                    },
                    "metric": {
                        "type": "string",
                        "title": "Metric",
                        "description": "gwp = global warming potential (CO2e)",
                        "enum": [
                            "gwp",
                            "other"
                        ]
                    },
                    "baseline": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000,
                        "title": "Baseline",
                        "description": "What the reduction is relative to, verbatim from the source"
                    },
                    "source_type": {
                        "type": "string",
                        "title": "Source Type",
                        "description": "primary = the brand's own site, PDF, blog or declaration. secondary = a retailer or press copy of brand text, only when the original can't be reached.",
                        "enum": [
                            "primary",
                            "secondary"
                        ]
                    },
                    "source_url": {
                        "type": "string",
                        "title": "Source URL",
                        "description": "Where the figure is published",
                        "format": "uri",
                        "pattern": "^https?://",
                        "maxLength": 1000,
                        "x-placeholder": "https://example.com/..."
                    },
                    "source_quote": {
                        "type": "string",
                        "title": "Source Quote",
                        "description": "Verbatim text from the source. Must contain the number exactly as written.",
                        "minLength": 1,
                        "maxLength": 2000
                    },
                    "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "title": "Retrieved",
                        "description": "Date the source was read (YYYY-MM-DD)"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "title": "Notes",
                        "description": "Caveats, conflicting sources, or anything a reader needs to interpret the value"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "reduction_pct",
                    "metric",
                    "baseline",
                    "source_type",
                    "source_url",
                    "source_quote",
                    "retrieved"
                ]
            },
            "minItems": 1
        }
    },
    "additionalProperties": false
}